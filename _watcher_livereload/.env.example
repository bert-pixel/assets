# Copy this file to .env and fill in your values. Never commit .env.

# --- SFTP connection ---
SFTP_HOST=example.com
SFTP_PORT=22
SFTP_USER=your-username
SFTP_PASSWORD=your-password

# Remote base directory that mirrors WATCH_DIR's structure.
# Only matters if WATCH_DIR ever contains non-scss files you want mirrored 1:1;
# if WATCH_DIR is scss-only, this is unused but still required to be set.
REMOTE_DIR=/var/www/html

# --- Local paths ---
# Folder to watch for scss (and any other) changes
WATCH_DIR=./src

# Your main .scss file that @use/@forward/@import's all the partials
SCSS_ENTRY=./src/main.scss

# Where the compiled bundle is written locally. This can live OUTSIDE
# WATCH_DIR (e.g. a sibling ./dist folder) — its remote destination is set
# independently below via BUNDLE_REMOTE_DIR, not by mirroring WATCH_DIR.
BUNDLE_LOCAL_PATH=./dist/bundle.css

# Fixed remote folder the compiled bundle.css is uploaded to (independent of
# REMOTE_DIR/WATCH_DIR mirroring above)
BUNDLE_REMOTE_DIR=/wp-content/themes/blauw/assets/css

# 'expanded' for readable CSS, 'compressed' for minified
SCSS_STYLE=expanded

# --- Behavior ---
# Push every existing file (and build+push the bundle) once on startup
INITIAL_SYNC=true

# Comma-separated substrings; any relative path containing one of these is skipped
IGNORE_PATTERNS=.map,.DS_Store

# --- LiveReload ---
# When true, a LiveReload server runs alongside the watcher and notifies the
# LiveReload browser extension after each successful upload, so the remote
# page reloads (bundle.css updates hot-swap in without a full reload).
ENABLE_LIVERELOAD=true
LIVERELOAD_PORT=35729
